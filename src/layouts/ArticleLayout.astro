---
import BaseLayout from './BaseLayout.astro';
interface Props {title:string;description:string;canonical:string;heading:string;eyebrow?:string;sections:{heading:string;body:string}[];related?:{href:string;label:string}[];note?:string;photo?:string;photoAlt?:string;photoCredit?:string;photoSource?:string;}
const {title,description,canonical,heading,eyebrow='American Mahjong / The Edit',sections,related=[],note,photo,photoAlt='Mahjong table scene',photoCredit,photoSource}=Astro.props;
const idFor=(heading:string,i:number)=>'section-'+(i+1);
---
<BaseLayout title={title} description={description} canonical={canonical}><main class="article-wrap"><div class="article-hero"><div><div class="article-eyebrow">{eyebrow}</div><h1 class="article-title">{heading}</h1><p class="article-intro">{description}</p></div>{photo?<figure class="article-photo"><img src={photo} alt={photoAlt} loading="eager" decoding="async"/>{photoCredit&&<figcaption>Photo: {photoSource?<a href={photoSource} target="_blank" rel="noopener noreferrer">{photoCredit}</a>:photoCredit} · Unsplash</figcaption>}</figure>:<div class="article-art" role="img" aria-label="Editorial illustration of an East wind Mahjong tile"></div>}</div><div class="article-body-layout"><aside class="article-toc" aria-label="On this page"><strong>On this page</strong>{sections.map((section,i)=><a href={'#'+idFor(section.heading,i)}>{section.heading}</a>)}</aside><div class="article-content">{sections.map((section,i)=><section id={idFor(section.heading,i)}><h2>{section.heading}</h2><p>{section.body}</p></section>)}{note&&<div class="article-note"><strong>Good to know</strong><p>{note}</p></div>}<div class="article-related"><h2>Keep the good times rolling.</h2><div class="related-grid">{related.map(item=><a href={item.href}>{item.label} ↗</a>)}<a href="/american-mahjong/">All American Mahjong guides ↗</a><a href="/#tools">Try the free tools ↗</a></div></div></div></div></main></BaseLayout>