---
import BaseLayout from './BaseLayout.astro';
import SetChecklist from '../components/SetChecklist.astro';
import TileExplorer from '../components/TileExplorer.astro';
interface Props {title:string;description:string;canonical:string;heading:string;eyebrow?:string;sections:{heading:string;body:string}[];related?:{href:string;label:string}[];note?:string;photo?:string;photoAlt?:string;photoCredit?:string;photoSource?:string;faq?:{question:string;answer:string}[];tileBreakdown?:{type:string;count:number;detail:string}[];showSetChecklist?:boolean;showTileExplorer?:boolean;}
const {title,description,canonical,heading,eyebrow='American Mahjong / The Edit',sections,related=[],note,photo,photoAlt='Mahjong table scene',photoCredit,photoSource,faq=[],tileBreakdown=[],showSetChecklist=false,showTileExplorer=false}=Astro.props;
const idFor=(heading:string,i:number)=>'section-'+(i+1);
const isAmerican=canonical.includes('/american-mahjong/');
const breadcrumbs=[{name:'Home',item:'https://mymahjongera.com/'},...(isAmerican?[{name:'American Mahjong',item:'https://mymahjongera.com/american-mahjong/'}]:[]),{name:heading,item:canonical}];
const breadcrumbSchema={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbs.map((x,i)=>({'@type':'ListItem',position:i+1,name:x.name,item:x.item}))};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(x=>({'@type':'Question',name:x.question,acceptedAnswer:{'@type':'Answer',text:x.answer}}))};
---
<BaseLayout title={title} description={description} canonical={canonical}><script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />{faq.length>0&&<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}<main class="article-wrap"><nav class="article-breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span>{isAmerican&&<><a href="/american-mahjong/">American Mahjong</a><span aria-hidden="true">/</span></>}<span aria-current="page">{heading}</span></nav><div class="article-hero"><div><div class="article-eyebrow">{eyebrow}</div><h1 class="article-title">{heading}</h1><p class="article-intro">{description}</p></div>{photo?<figure class="article-photo"><img src={photo} alt={photoAlt} loading="eager" decoding="async"/>{photoCredit&&<figcaption>Photo: {photoSource?<a href={photoSource} target="_blank" rel="noopener noreferrer">{photoCredit}</a>:photoCredit} · Unsplash</figcaption>}</figure>:<div class="article-art" role="img" aria-label="Editorial illustration of an East wind Mahjong tile"></div>}</div><div class="article-body-layout"><aside class="article-toc" aria-label="On this page"><strong>On this page</strong>{sections.map((section,i)=><a href={'#'+idFor(section.heading,i)}>{section.heading}</a>)}</aside><div class="article-content">{sections.map((section,i)=><section id={idFor(section.heading,i)}><h2>{section.heading}</h2><p>{section.body}</p></section>)}{showSetChecklist&&<SetChecklist />}{showTileExplorer&&<TileExplorer />}{tileBreakdown.length>0&&<section class="article-tile-table"><h2>American Mahjong tile count at a glance</h2><div class="table-scroll"><table><thead><tr><th>Tile family</th><th>Count</th><th>What is included</th></tr></thead><tbody>{tileBreakdown.map(tile=><tr><th scope="row">{tile.type}</th><td>{tile.count}</td><td>{tile.detail}</td></tr>)}</tbody><tfoot><tr><th scope="row">Total</th><td>{tileBreakdown.reduce((sum,tile)=>sum+tile.count,0)}</td><td>Standard playing tiles</td></tr></tfoot></table></div></section>}{faq.length>0&&<section class="article-faq"><h2>Frequently asked questions</h2>{faq.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}{note&&<div class="article-note"><strong>Good to know</strong><p>{note}</p></div>}<div class="article-related"><h2>Keep the good times rolling.</h2><div class="related-grid">{related.map(item=><a href={item.href}>{item.label} ↗</a>)}<a href="/american-mahjong/">All American Mahjong guides ↗</a><a href="/#tools">Try the free tools ↗</a></div></div></div></div></main></BaseLayout>