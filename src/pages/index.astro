<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#fff7f7"/><link rel="canonical" href="https://mymahjongera.com/"/><title>{title}</title><style>
:root{font-family:Arial,Helvetica,sans-serif;color:#4d2540;background:#fffaf7}*{box-sizing:border-box}body{margin:0}a{color:inherit}nav{display:flex;justify-content:space-between;align-items:center;padding:22px max(24px,calc((100vw - 1100px)/2));gap:20px;background:#fff5f6}nav .brand{font-size:24px;font-weight:800;text-decoration:none;color:#9f315c}nav .links{display:flex;gap:24px;flex-wrap:wrap;font-size:14px}main{max-width:1150px;margin:auto;padding:0 24px}.hero{padding:90px 0 75px;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:40px}.eyebrow{font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#a94469}h1{font-size:clamp(48px,7vw,88px);letter-spacing:-.065em;line-height:1.03;margin:18px 0}h2{font-family:Georgia,serif;font-size:clamp(31px,4vw,48px);letter-spacing:-.035em}p{line-height:1.65;color:#684b59}.lead{font-size:20px;max-width:540px}.btn{display:inline-block;background:#a93d69;color:white;padding:15px 23px;border-radius:50px;text-decoration:none;font-weight:700;margin:12px 8px 0 0}.btn.alt{background:#f9dfeb;color:#91365e}.art{height:430px;border-radius:220px 220px 22px 22px;background:radial-gradient(circle at 48% 33%,#fffbf0 0 13%,transparent 14%),linear-gradient(125deg,#f8b9cd,#fff0ef 60%,#b7d0bc);display:grid;place-items:center;box-shadow:0 25px 50px #b14e7130}.tiles{display:grid;grid-template-columns:repeat(3,75px);gap:11px;transform:rotate(-12deg)}.tile{display:grid;place-items:center;height:95px;border:4px solid white;border-radius:10px;background:#fff9ec;color:#ad4972;font-family:Georgia,serif;font-size:36px;box-shadow:0 7px 0 #e5a3b5,0 14px 22px #9c48602b}.section{padding:48px 0 75px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:#fff;border:1px solid #f2d9e0;border-radius:22px;padding:30px;min-height:210px}.card h3{font-family:Georgia,serif;font-size:24px}.card a{font-weight:700;color:#a33b62}.pink{background:#fce8ee;border-radius:28px;padding:38px}.world{background:#f4f0e7;border-radius:28px;padding:36px}.tool{background:#fff;border-radius:20px;padding:24px;box-shadow:0 3px 12px #7b345019}.controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.controls input{width:100px;padding:12px;border:1px solid #e5beca;border-radius:10px}.controls button{padding:12px 16px;background:#a93d69;border:0;border-radius:10px;color:#fff;cursor:pointer}.scores{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.score{padding:16px;background:#fff5f6;border-radius:12px}.score strong{font-size:26px}.seats{font-size:21px;font-weight:700;margin:18px 0;color:#9f315c}footer{background:#fce8ee;padding:32px 24px;text-align:center;margin-top:40px;font-size:13px;color:#805368}@media(max-width:750px){nav{padding:18px 24px;align-items:flex-start;flex-direction:column}.hero{grid-template-columns:1fr;padding:52px 0}.art{height:290px}.cards{grid-template-columns:1fr}.scores{grid-template-columns:repeat(2,1fr)}.section{padding:28px 0 52px}}
</style></head><body>
<nav><a class="brand" href="/">my mahjong era ✿</a><div class="links"><a href="/learn/american-mahjong/">Learn</a><a href="/world/">Around the World</a><a href="/lifestyle/mahjong-night/">Lifestyle</a><a href="#tools">Free Tools</a></div></nav>
<main><section class="hero"><div><div class="eyebrow">Your table. Your people. Your era.</div><h1>It's your<br/>Mahjong Era.</h1><p class="lead">Learn the tiles, find your people, and make every game night a little more magical.</p><a class="btn" href="/learn/american-mahjong/">Start playing →</a><a class="btn alt" href="#tools">Explore free tools</a></div><div class="art" aria-label="Decorative illustration of Mahjong tiles"><div class="tiles">{['東','南','西','中','發','北'].map(t=><div class="tile">{t}</div>)}</div></div></section>
<section class="section"><div class="eyebrow">New here? Start here.</div><h2>Make room for Mahjong.</h2><div class="cards"><article class="card"><span>01 / GET STARTED</span><h3>American Mahjong, made approachable.</h3><p>Get a friendly introduction to the table, the tiles, and the rhythm of the game.</p><a href="/learn/american-mahjong/">Learn the basics →</a></article><article class="card"><span>02 / GATHER</span><h3>Host a Mahjong night.</h3><p>A welcoming guide to playing together, especially if it is everyone's first game.</p><a href="/lifestyle/mahjong-night/">Plan your night →</a></article><article class="card"><span>03 / DISCOVER</span><h3>Explore the world's Mahjong.</h3><p>From American Mah Jongg to Chinese regional styles and Japanese riichi.</p><a href="/world/">See the variations →</a></article></div></section>
<section class="section" id="tools"><div class="pink"><div class="eyebrow">Our free playroom</div><h2>A little help for game night.</h2><p>Two quick, free tools. No sign-up needed.</p><div class="cards"><div class="tool"><h3>Seat & Wind Picker</h3><p>Randomly assign East, South, West and North.</p><button class="btn" id="pick" type="button">Shuffle seats</button><div class="seats" id="seats" aria-live="polite">Ready to shuffle?</div></div><div class="tool" style="grid-column:span 2"><h3>Score Tracker</h3><p>Manually record scores for four players. Scores are saved in this browser. This tool does not validate official winning hands.</p><div class="scores" id="scores"></div><div class="controls" style="margin-top:15px"><label for="player">Player</label><select id="player"><option value="0">Player 1</option><option value="1">Player 2</option><option value="2">Player 3</option><option value="3">Player 4</option></select><label for="points">Points</label><input id="points" type="number" value="10"/><button id="add" type="button">Add points</button><button id="reset" type="button">Reset</button></div></div></div></div></section>
<section class="section"><div class="world"><div class="eyebrow">One game. Many traditions.</div><h2>Mahjong belongs to a whole world of stories.</h2><p>Discover the remarkable ways people play, gather and connect around Mahjong tables.</p><a class="btn" href="/world/">Explore the world of Mahjong →</a></div></section></main>
<footer>© {new Date().getFullYear()} My Mahjong Era · Independent Mahjong learning & lifestyle project · Not affiliated with National Mah Jongg League or any Mahjong retailer.</footer>
<script is:inline>
(function(){const winds=['East','South','West','North'];document.getElementById('pick').addEventListener('click',()=>{const x=[...winds];for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]];}document.getElementById('seats').textContent=x.map((v,i)=>'Player '+(i+1)+': '+v).join(' · ');});let scores;try{scores=JSON.parse(localStorage.getItem('mahjongEraScores'))}catch{}if(!Array.isArray(scores)||scores.length!==4||scores.some(n=>!Number.isFinite(n)))scores=[0,0,0,0];const root=document.getElementById('scores');function render(){root.innerHTML=scores.map((n,i)=>'<div class="score">Player '+(i+1)+'<br/><strong>'+n+'</strong></div>').join('');localStorage.setItem('mahjongEraScores',JSON.stringify(scores));}document.getElementById('add').addEventListener('click',()=>{const i=Number(document.getElementById('player').value),v=Number(document.getElementById('points').value);if(Number.isFinite(v)){scores[i]+=v;render();}});document.getElementById('reset').addEventListener('click',()=>{if(confirm('Clear all scores?')){scores=[0,0,0,0];render();}});render();})();
</script></body></html>