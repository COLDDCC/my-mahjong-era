---
import BaseLayout from '../layouts/BaseLayout.astro';
const title="American Mahjong for Beginners, Guides & Free Tools | My Mahjong Era";
const description="Discover American Mahjong for beginners: learn how to play, explore rules and Mahjong night ideas, and use free score tracking and wind picker tools at My Mahjong Era.";
---
<BaseLayout {title} {description} canonical="https://mymahjongera.com/"><style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#4d2540;background:#fffaf7}*{box-sizing:border-box}body{margin:0}a{color:inherit}.legacy-nav-unused{display:flex;justify-content:space-between;align-items:center;padding:22px max(24px,calc((100vw - 1100px)/2));gap:20px;background:#fff5f6}.legacy-nav-unused .brand{font-size:24px;font-weight:800;text-decoration:none;color:#9f315c}.legacy-nav-unused .links{display:flex;gap:24px;flex-wrap:wrap;font-size:14px}main{max-width:1150px;margin:auto;padding:0 24px}.hero{padding:90px 0 75px;display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:40px}.eyebrow{font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#a94469}h1{font-size:clamp(48px,7vw,88px);letter-spacing:-.065em;line-height:1.03;margin:18px 0}h2{font-family:Georgia,serif;font-size:clamp(31px,4vw,48px);letter-spacing:-.035em}p{line-height:1.65;color:#684b59}.lead{font-size:20px;max-width:540px}.btn{display:inline-block;background:#a93d69;color:white;padding:15px 23px;border-radius:50px;text-decoration:none;font-weight:700;margin:12px 8px 0 0}.btn.alt{background:#f9dfeb;color:#91365e}.art{height:430px;border-radius:220px 220px 22px 22px;background:radial-gradient(circle at 48% 33%,#fffbf0 0 13%,transparent 14%),linear-gradient(125deg,#f8b9cd,#fff0ef 60%,#b7d0bc);display:grid;place-items:center;box-shadow:0 25px 50px #b14e7130}.tiles{display:grid;grid-template-columns:repeat(3,75px);gap:11px;transform:rotate(-12deg)}.tile{display:grid;place-items:center;height:95px;border:4px solid white;border-radius:10px;background:#fff9ec;color:#ad4972;font-family:Georgia,serif;font-size:36px;box-shadow:0 7px 0 #e5a3b5,0 14px 22px #9c48602b}.section{padding:48px 0 75px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:#fff;border:1px solid #f2d9e0;border-radius:22px;padding:30px;min-height:210px}.card h3{font-family:Georgia,serif;font-size:24px}.card a{font-weight:700;color:#a33b62}.pink{background:#fce8ee;border-radius:28px;padding:38px}.world{background:#f4f0e7;border-radius:28px;padding:36px}.tool{background:#fff;border-radius:20px;padding:24px;box-shadow:0 3px 12px #7b345019}.controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.controls input{width:100px;padding:12px;border:1px solid #e5beca;border-radius:10px}.controls button{padding:12px 16px;background:#a93d69;border:0;border-radius:10px;color:#fff;cursor:pointer}.scores{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.score{padding:16px;background:#fff5f6;border-radius:12px}.score strong{font-size:26px}.seats{font-size:21px;font-weight:700;margin:18px 0;color:#9f315c}footer{background:#fce8ee;padding:32px 24px;text-align:center;margin-top:40px;font-size:13px;color:#805368}@media(max-width:750px){.legacy-nav-unused{padding:18px 24px;align-items:flex-start;flex-direction:column}.hero{grid-template-columns:1fr;padding:52px 0}.art{height:290px}.cards{grid-template-columns:1fr}.scores{grid-template-columns:repeat(2,1fr)}.section{padding:28px 0 52px}}

/* Editorial redesign v2: deliberate typography, rhythm and texture */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');
:root{font-family:'DM Sans',Arial,sans-serif;color:#512b37;background:#fffcf8}body{background:#fffcf8}.legacy-nav-unused{background:#fffcf8;border-bottom:1px solid #eadce0;position:relative;z-index:2}.legacy-nav-unused .brand{font-family:'Playfair Display',Georgia,serif;font-size:27px;letter-spacing:-.055em;color:#9b3d5c}.legacy-nav-unused .links{font-weight:600;gap:30px}.legacy-nav-unused .links a{text-decoration:none}.legacy-nav-unused .links a:hover{color:#a94169}main{max-width:1240px}.hero{min-height:660px;padding:80px 0 90px;grid-template-columns:1fr 1.05fr;gap:6vw}.eyebrow{font-size:11px;letter-spacing:.22em;color:#9f4762}h1{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(65px,7.4vw,114px);letter-spacing:-.07em;line-height:1.02;margin:22px 0 26px}h2{font-family:'Playfair Display',Georgia,serif;font-weight:600;letter-spacing:-.055em}p{color:#715864}.lead{font-size:19px;max-width:440px;line-height:1.8}.btn{font-size:13px;letter-spacing:.025em;padding:17px 26px;background:#9e3e61;transition:transform .2s,background .2s}.btn:hover{transform:translateY(-2px);background:#7d2e4a}.btn.alt{background:transparent;color:#873b59;border:1px solid #b7778f}.art{height:540px;border-radius:48% 48% 5px 5px;background:radial-gradient(ellipse at 70% 22%,#fdf3d5 0 8%,transparent 8.5%),radial-gradient(ellipse at 25% 70%,#f4b5b6 0 13%,transparent 13.5%),linear-gradient(135deg,#eeb4c6 0%,#f9e3d9 43%,#c8d4ba 100%);position:relative;overflow:hidden;box-shadow:none}.art:before{content:'THE ART OF THE GAME';position:absolute;top:24px;left:30px;letter-spacing:.3em;font-size:10px;font-weight:700;color:#7b5360}.art:after{content:'EST. YOUR ERA';position:absolute;bottom:25px;right:30px;letter-spacing:.22em;font-size:10px;color:#7b5360}.tiles{grid-template-columns:repeat(3,85px);gap:13px;transform:rotate(-13deg)}.tile{height:113px;border:6px solid #fffdf8;border-radius:9px;background:#fdf8e9;box-shadow:0 9px 0 #8baf9a,0 16px 20px #733f4430;color:#b5496c;font-size:40px}.section{padding:70px 0 95px}.cards{gap:22px}.card{border:0;border-radius:3px;padding:38px 30px;background:#f8f0ec;min-height:265px;transition:transform .2s}.card:nth-child(2){background:#f8e8ec}.card:nth-child(3){background:#eef1e9}.card:hover{transform:translateY(-4px)}.card span{font-size:10px;letter-spacing:.18em;font-weight:700;color:#a45d75}.card h3{font-family:'Playfair Display',Georgia,serif;font-size:29px;line-height:1.2;letter-spacing:-.04em}.card a{font-size:13px}.pink{background:#f8e9e8;border-radius:3px;padding:55px}.world{background:#e9eee6;border-radius:3px;padding:60px}.tool{border-radius:3px;box-shadow:none}.editorial-strip{margin:0 calc(50% - 50vw);padding:18px 24px;background:#9e3e61;color:#fff7ef;display:flex;justify-content:center;gap:42px;flex-wrap:wrap;font-size:11px;letter-spacing:.19em;text-transform:uppercase;font-weight:700}.feature-kicker{font-size:12px;color:#9e3e61;text-transform:uppercase;letter-spacing:.19em;font-weight:700}.intro-note{max-width:610px;margin-top:-15px;margin-bottom:35px;font-size:18px}.world h2{max-width:760px}.world p{max-width:700px}footer{background:#ead4d9;color:#684a55}.seats{font-size:16px;line-height:1.8}@media(max-width:750px){.legacy-nav-unused .brand{font-size:24px}.legacy-nav-unused .links{gap:14px;font-size:12px}.hero{grid-template-columns:1fr;min-height:0;padding:54px 0 50px;gap:32px}h1{font-size:clamp(57px,13vw,83px)}.art{height:360px}.tiles{grid-template-columns:repeat(3,60px)}.tile{height:82px;font-size:30px}.pink,.world{padding:28px 22px}.section{padding:45px 0 60px}.editorial-strip{gap:14px;font-size:9px}.cards{grid-template-columns:1fr}.card{min-height:0}}

/* V3: photography-first art direction */
body{background:#fffaf3;color:#462d34}.legacy-nav-unused{background:#fffaf3}.legacy-nav-unused .brand{font-size:30px}.hero{min-height:730px;grid-template-columns:1fr 1.08fr;gap:4vw;padding-top:54px;padding-bottom:70px}.hero h1{font-size:clamp(62px,7.1vw,108px);line-height:1.02}.hero h1 em{color:#b34b69;font-weight:500}.hero .lead{max-width:410px}.hero-photo{position:relative;height:620px;overflow:hidden;background:#e7d7cd}.hero-photo img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.85) contrast(1.04)}.hero-photo:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(44,23,30,.52),transparent 33%);pointer-events:none}.photo-caption{position:absolute;z-index:1;bottom:24px;left:24px;right:24px;color:white;font-size:10px;font-weight:700;letter-spacing:.16em}.photo-stamp{position:absolute;z-index:1;right:24px;top:24px;width:112px;height:112px;border-radius:50%;background:#f3d5db;color:#8e3553;display:grid;place-items:center;text-align:center;font:700 16px/1.1 'DM Sans',sans-serif;transform:rotate(12deg)}.editorial-strip{background:#a94564;padding:22px}.card{position:relative;overflow:hidden;min-height:280px}.card:before{content:'✳';position:absolute;top:10px;right:25px;font:58px Georgia,serif;color:#c57b92;opacity:.35}.pink{background:#f0d9df}.world{background:#e7e9d9}.photo-credit{font-size:11px;color:#8d7278;text-align:right;margin-top:-40px;margin-bottom:40px}.photo-credit a{color:inherit}@media(max-width:750px){.hero{min-height:0;grid-template-columns:1fr;padding:42px 0 52px}.hero h1{font-size:clamp(58px,12vw,84px)}.hero-photo{height:410px}.photo-stamp{width:90px;height:90px;font-size:13px}.photo-caption{font-size:8px}.photo-credit{margin-top:-26px;margin-bottom:28px}}

/* V4 final homepage polish */
:root{font-family:'DM Sans',Arial,sans-serif;background:#fffaf4;color:#49303b}.site-header{background:#fffaf4}.site-nav{padding:0;background:transparent;display:flex}.site-nav a{font-family:'DM Sans',Arial,sans-serif}.site-logo{font-size:29px}.site-footer{font-family:'DM Sans',Arial,sans-serif}.hero{padding-top:75px;padding-bottom:90px}.hero h1{font-family:'Playfair Display',Georgia,serif;font-weight:500}.hero .eyebrow{font-size:11px;letter-spacing:.21em}.hero-photo{height:610px}.hero-photo img{background:#e6c4c9}.hero-photo img[alt]{color:#785463}.section{padding-top:80px;padding-bottom:85px}.section h2{font-size:clamp(38px,4.5vw,60px)}.card h3{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:31px}.card{min-height:300px;padding:36px 32px}.card p{font-size:15px}.pink,.world{border-radius:2px}.tool{border:1px solid #e8d8dd;border-radius:4px}.btn{border-radius:2px}.btn.alt{border:1px solid #a34162;background:transparent}.photo-caption{letter-spacing:.11em}@media(max-width:750px){.hero{padding-top:35px;padding-bottom:55px}.hero-photo{height:430px}.section{padding-top:48px;padding-bottom:58px}.card{min-height:0}.site-nav{padding:0}.site-header-inner{gap:12px}}</style><main><section class="hero"><div><div class="eyebrow">American Mahjong for a new generation</div><h1>Mahjong<br/><em>looks good</em><br/>on you.</h1><p class="lead">A fresh take on American Mahjong. Learn the game, gather your favorite people, and make every table your own.</p><a class="btn" href="/american-mahjong/">Start with American Mahjong →</a><a class="btn alt" href="#tools">Explore free tools</a></div><div class="hero-photo"><img src="https://unsplash.com/photos/K0pFTjeb4oY/download?force=true&w=1400" alt="Editorial lifestyle photograph" loading="eager" fetchpriority="high"/><div class="photo-caption">GOOD FRIENDS. GREAT HANDS. &nbsp; / &nbsp; THE MAHJ EDIT</div><div class="photo-stamp">PLAY<br/>MORE<br/>MAHJ ✳</div></div></section><div class="editorial-strip"><span>American Mahjong</span><span>Play beautifully</span><span>Make it a tradition</span></div>
<section class="section"><div class="eyebrow">New here? Start here.</div><h2>Make room for Mahjong.</h2><p class="intro-note">The modern girl’s guide to American Mahjong—learn the rules, bring your favorite people together, and make the table your own.</p><div class="cards"><article class="card"><span>01 / GET STARTED</span><h3>Learn American Mahjong, made approachable.</h3><p>Get a friendly introduction to the table, the tiles, and the rhythm of the game.</p><a href="/american-mahjong/">Explore American Mahjong →</a></article><article class="card"><span>02 / GATHER</span><h3>Host a Mahjong night.</h3><p>A welcoming guide to playing together, especially if it is everyone's first game.</p><a href="/lifestyle/mahjong-night/">Plan your night →</a></article><article class="card"><span>03 / DISCOVER</span><h3>Explore the world's Mahjong.</h3><p>From American Mah Jongg to Chinese regional styles and Japanese riichi.</p><a href="/world/">See the variations →</a></article></div></section>
<section class="section" aria-labelledby="popular-guides"><div class="eyebrow">The American Mahjong edit</div><h2 id="popular-guides">Your next move starts here.</h2><p class="intro-note">Explore the essentials, from your first American Mahjong set to understanding the annual card.</p><div class="cards"><article class="card"><span>SHOP SMARTER</span><h3>Find your first American Mahjong set.</h3><p>Know what to look for before choosing tiles, racks and accessories.</p><a href="/american-mahjong/sets/">Explore sets →</a></article><article class="card"><span>LEARN THE CARD</span><h3>What is the American Mahjong card?</h3><p>Understand why it changes and how it shapes winning hands.</p><a href="/american-mahjong/card/">Read the guide →</a></article><article class="card"><span>MASTER THE BASICS</span><h3>American Mahjong rules, without the overwhelm.</h3><p>Get familiar with the Charleston, jokers and exposed hands.</p><a href="/american-mahjong/rules/">Learn the rules →</a></article></div></section><section class="section" id="tools"><div class="pink"><div class="eyebrow">Our free playroom</div><h2>Free American Mahjong game night tools.</h2><p>Two quick, free tools. No sign-up needed.</p><div class="cards"><div class="tool"><h3>Seat & Wind Picker</h3><p>Randomly assign East, South, West and North.</p><button class="btn" id="pick" type="button">Shuffle seats</button><div class="seats" id="seats" aria-live="polite">Ready to shuffle?</div></div><div class="tool" style="grid-column:span 2"><h3>Score Tracker</h3><p>Manually record scores for four players. Scores are saved in this browser. This tool does not validate official winning hands.</p><div class="scores" id="scores"></div><div class="controls" style="margin-top:15px"><label for="player">Player</label><select id="player"><option value="0">Player 1</option><option value="1">Player 2</option><option value="2">Player 3</option><option value="3">Player 4</option></select><label for="points">Points</label><input id="points" type="number" value="10"/><button id="add" type="button">Add points</button><button id="reset" type="button">Reset</button></div></div></div></div></section>
<section class="section"><div class="world"><div class="eyebrow">One game. Many traditions.</div><h2>Mahjong belongs to a whole world of stories.</h2><p>Discover the remarkable ways people play, gather and connect around Mahjong tables.</p><a class="btn" href="/world/">Explore the world of Mahjong →</a></div></section></main>
<script is:inline>
(function(){const winds=['East','South','West','North'];document.getElementById('pick').addEventListener('click',()=>{const x=[...winds];for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]];}document.getElementById('seats').textContent=x.map((v,i)=>'Player '+(i+1)+': '+v).join(' · ');});let scores;try{scores=JSON.parse(localStorage.getItem('mahjongEraScores'))}catch{}if(!Array.isArray(scores)||scores.length!==4||scores.some(n=>!Number.isFinite(n)))scores=[0,0,0,0];const root=document.getElementById('scores');function render(){root.innerHTML=scores.map((n,i)=>'<div class="score">Player '+(i+1)+'<br/><strong>'+n+'</strong></div>').join('');localStorage.setItem('mahjongEraScores',JSON.stringify(scores));}document.getElementById('add').addEventListener('click',()=>{const i=Number(document.getElementById('player').value),v=Number(document.getElementById('points').value);if(Number.isFinite(v)){scores[i]+=v;render();}});document.getElementById('reset').addEventListener('click',()=>{if(confirm('Clear all scores?')){scores=[0,0,0,0];render();}});render();})();
</script></BaseLayout>
