---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
const title="How to Host a Mahjong Night | My Mahjong Era";
const description="Throw a beginner-friendly Mahjong night with welcoming invitations, a comfortable table setup, snacks and simple tips.";
