const sections=[
  {
    "heading": "Check the ruleset first",
    "body": "Not every Mahjong set is designed for American Mah Jongg. Verify that the set has the required jokers and flowers and that its tile mix works with the annual card you plan to use."
  },
  {
    "heading": "Look for 152 tiles",
    "body": "Many contemporary American-style sets contain 152 tiles, including eight jokers. Check the full component list rather than relying on the product name alone."
  },
  {
    "heading": "Racks and pushers",
    "body": "Racks hold your tiles upright. Pushers can make it easier to move a wall without reaching across the table. Check whether racks and pushers are included or sold separately."
  },
  {
    "heading": "Tile size and readability",
    "body": "Choose tiles with legible markings and a comfortable weight. Compare dimensions before purchasing; larger tiles may need a larger table."
  },
  {
    "heading": "Budget for the annual card",
    "body": "A beautiful tile set is not a replacement for the current annual hand card. Budget for the reference material used by your playing group."
  },
  {
    "heading": "Where to buy",
    "body": "You can compare independent retailers and official products, but always verify specifications, shipping and return terms. My Mahjong Era does not currently operate a store or claim retailer affiliation."
  }
];
