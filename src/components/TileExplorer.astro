---
// Original educational tile illustrations, not scans or reproductions of commercial tile art.
const families=[
{id:'dots',name:'Dots',count:36,sub:'Circles · 1–9',color:'teal',tiles:Array.from({length:9},(_,i)=>({face:String(i+1),label:(i+1)+' Dot',n:i+1})),desc:'Four of each number from 1 through 9. Dots are one of the three numbered suits.'},
{id:'bams',name:'Bams',count:36,sub:'Bamboo · 1–9',color:'green',tiles:Array.from({length:9},(_,i)=>({face:String(i+1),label:(i+1)+' Bam',n:i+1})),desc:'Four of each number from 1 through 9. Bamboo is another numbered suit.'},
{id:'craks',name:'Craks',count:36,sub:'Characters · 1–9',color:'rose',tiles:Array.from({length:9},(_,i)=>({face:String(i+1),label:(i+1)+' Crak',n:i+1})),desc:'Four of each number from 1 through 9. Craks are the character suit.'},
{id:'winds',name:'Winds',count:16,sub:'Four directions',color:'gold',tiles:[{face:'東',label:'East'},{face:'南',label:'South'},{face:'西',label:'West'},{face:'北',label:'North'}],desc:'Four of each wind: East, South, West and North.'},
{id:'dragons',name:'Dragons',count:12,sub:'Red · Green · White',color:'rose',tiles:[{face:'中',label:'Red'},{face:'發',label:'Green'},{face:'□',label:'White'}],desc:'Four of each dragon. White dragon artwork varies by manufacturer.'},
{id:'flowers',name:'Flowers',count:8,sub:'Special tiles',color:'gold',tiles:[{face:'✿',label:'Flower'}],desc:'Eight flower tiles in the common American playing set. Individual flower designs vary.'},
{id:'jokers',name:'Jokers',count:8,sub:'Special tiles',color:'teal',tiles:[{face:'★',label:'Joker'}],desc:'Eight jokers. They are not universal wildcards; follow the official rules for permitted substitutions.'}
];
---
<section class="tile-explorer" id="tile-explorer" aria-labelledby="tile-explorer-title">
  <div class="tile-explorer-head"><p class="tile-kicker">THE TILE LIBRARY · INTERACTIVE REFERENCE</p><h2 id="tile-explorer-title">Meet the 152 tiles.</h2><p>Explore each family, see how many tiles belong to it, and learn the essentials before your first game.</p></div>
  <div class="tile-explorer-summary"><span><strong>152</strong> playing tiles</span><span><strong>7</strong> tile families</span><span><strong>4</strong> copies of each numbered tile</span></div>
  <div class="tile-tabs" role="group" aria-label="Filter tile families">
    <button type="button" class="is-active" data-family="all" aria-pressed="true">All tiles</button>
    {families.map(f=><button type="button" data-family={f.id} aria-pressed="false">{f.name}<span>{f.count}</span></button>)}
  </div>
  <div class="tile-family-grid">
    {families.map(f=><article class={'tile-family tile-'+f.color} data-tile-family={f.id}>
      <div class="tile-family-top"><div><p class="tile-family-kicker">{f.sub}</p><h3>{f.name}</h3></div><span class="tile-family-count">{f.count} tiles</span></div>
      <div class="tile-gallery" aria-label={f.name+' tile examples'}>
        {f.tiles.map(t=><div class="tile-sample"><div class="tile-face" role="img" aria-label={t.label}>{f.id==='dots'?<span class="tile-pips" aria-hidden="true">{Array.from({length:t.n??1},(_,i)=><i class={'pip pip-'+(i%3)}></i>)}</span>:f.id==='bams'?<span class="tile-bamboo" aria-hidden="true">{Array.from({length:t.n??1},(_,i)=><i class="bamboo-stalk"></i>)}</span>:<span class="tile-glyph">{t.face}</span>}<span class="tile-face-caption">{f.id==='dots'?'DOT':f.id==='bams'?'BAM':f.id==='craks'?'CRAK':f.name.toUpperCase()}</span></div><span class="tile-label">{t.label}</span></div>)}
      </div>
      <p class="tile-family-description">{f.desc}</p>
    </article>)}
  </div>
  <p class="tile-explorer-note">Illustrative reference symbols, not photographs of actual tiles. Numbered examples show one of each rank; the standard set contains four copies of every rank. Tile artwork differs between manufacturers.</p>
</section>
<style>
.tile-explorer{margin:45px 0 60px;padding:clamp(18px,3.5vw,35px);background:#f8f3ed;border:1px solid #e8dcd1;color:#44383b}.tile-kicker,.tile-family-kicker{font-size:10px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:#96617a}.tile-explorer-head h2{font-family:Georgia,serif;font-size:clamp(28px,4vw,42px);font-weight:400;line-height:1.18;margin:10px 0}.tile-explorer-head>p:last-child{font-size:15px;line-height:1.7;color:#756a6b}.tile-explorer-summary{display:flex;flex-wrap:wrap;gap:10px 25px;margin:22px 0 25px;padding:15px 0;border-top:1px solid #e2d6cd;border-bottom:1px solid #e2d6cd;font-size:13px}.tile-explorer-summary strong{font-size:18px;color:#864a61}.tile-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}.tile-tabs button{border:1px solid #d9c9c8;background:#fffaf6;color:#604b53;border-radius:2px;padding:9px 12px;font:inherit;font-size:12px;cursor:pointer}.tile-tabs button span{margin-left:6px;color:#927c81}.tile-tabs button.is-active,.tile-tabs button[aria-pressed=true]{background:#813e5a;color:#fff;border-color:#813e5a}.tile-tabs button.is-active span{color:#f5e6eb}.tile-pips,.tile-bamboo{width:80%;height:67%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:1fr;align-items:center;justify-items:center;gap:2px}.tile-pips .pip{width:clamp(5px,1.15vw,11px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 32% 28%,#b8e1d9 0 14%,#267c79 16% 65%,#155451 70%);box-shadow:inset 0 0 0 1px #215e58}.tile-pips .pip-1{background:radial-gradient(circle at 32% 28%,#f5c5bf 0 14%,#b54b55 16% 65%,#7d2b3d 70%)}.tile-pips .pip-2{background:radial-gradient(circle at 32% 28%,#b5d6b5 0 14%,#518260 16% 65%,#2e6044 70%)}.tile-bamboo .bamboo-stalk{height:75%;width:clamp(4px,.9vw,8px);border-radius:3px;background:repeating-linear-gradient(to bottom,#2f775a 0 28%,#e0f0d5 29% 33%,#5b9b70 34% 65%,#e0f0d5 66% 70%,#2f775a 71% 100%);transform:rotate(-4deg)}.tile-face{background:linear-gradient(145deg,#fffefa,#f5efe3);box-shadow:2px 3px 0 #d5cbbd,3px 5px 8px #00000012;transition:transform .18s ease,box-shadow .18s ease}.tile-sample:hover .tile-face{transform:translateY(-3px);box-shadow:2px 5px 0 #d5cbbd,3px 8px 12px #00000018}.tile-family-grid{display:grid;gap:17px}.tile-family[hidden]{display:none}.tile-tabs button:focus-visible{outline:3px solid #4d8076;outline-offset:3px}@media(prefers-reduced-motion:reduce){.tile-face{transition:none}}.tile-family{background:#fffdfa;border:1px solid #e8ddd5;padding:20px}.tile-family-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px}.tile-family-top h3{font-family:Georgia,serif;font-size:25px;font-weight:400;margin:3px 0}.tile-family-count{white-space:nowrap;font-size:12px;background:#f5e9eb;padding:6px 9px}.tile-gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(58px,1fr));gap:8px}.tile-sample{display:grid;justify-items:center;gap:7px;min-width:0}.tile-face{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;width:100%;max-width:78px;aspect-ratio:.74;background:#fffef9;border:1px solid #d6c9b9;border-bottom:4px solid #b5aa9a;border-radius:5px;box-shadow:1px 2px 3px #0000000b}.tile-glyph{font-family:Georgia,serif;font-size:clamp(22px,3vw,33px);line-height:1}.tile-teal .tile-glyph{color:#427d79}.tile-green .tile-glyph{color:#528367}.tile-rose .tile-glyph{color:#a84b62}.tile-gold .tile-glyph{color:#a27b39}.tile-face-caption{font-size:8px;letter-spacing:.08em;color:#8b7d7b}.tile-label{font-size:10px;text-align:center;color:#70656a}.tile-family-description{font-size:13px;line-height:1.7;margin:17px 0 0;color:#766b6e}.tile-explorer-note{font-size:12px;line-height:1.6;margin-top:17px;color:#786c6e}@media(max-width:600px){.tile-family{padding:14px}.tile-gallery{grid-template-columns:repeat(auto-fit,minmax(45px,1fr));gap:6px}.tile-face-caption{font-size:7px}.tile-label{font-size:9px}.tile-tabs button{padding:9px 10px}}
</style>
<script>
const explorer=document.querySelector('#tile-explorer');
if(explorer){
 const buttons=Array.from(explorer.querySelectorAll<HTMLButtonElement>('[data-family]'));
 const cards=Array.from(explorer.querySelectorAll<HTMLElement>('[data-tile-family]'));
 buttons.forEach(button=>button.addEventListener('click',()=>{
   const selected=button.dataset.family;
   buttons.forEach(b=>{const active=b===button;b.classList.toggle('is-active',active);b.setAttribute('aria-pressed',String(active))});
   cards.forEach(card=>{card.hidden=selected!=='all'&&card.dataset.tileFamily!==selected});
 }));
}
</script>
